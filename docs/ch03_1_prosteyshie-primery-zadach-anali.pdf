<0000> <FFFF>
endcodespacerange
2 beginbfchar
<0001> <F129>
<0002> <F071>
endbfchar
endcmap
CMapName currentdict /CMap defineresource pop
end
end
%%EndResource
%%EOF
endstream
endobj

